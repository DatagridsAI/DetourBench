   },
   "sec_1910.124": {
    "desc": "\u00a7 1910.124 \u2014 General requirements for dipping and coating operations. Cross-references: \u00a7 1910.6, \u00a7 1910.146, \u00a7 1910.141, \u00a7 1910.134. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.141."
   },
   "sec_1910.120": {
