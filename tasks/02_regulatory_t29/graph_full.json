   "sec_1926.13": {
    "desc": "\u00a7 1926.13 \u2014 Interpretation of statutory terms. No further cross-references."
   },
   "sec_1910.95": {
    "desc": "\u00a7 1910.95 \u2014 Occupational noise exposure. No further cross-references."
   },
   "sec_1910.7": {
    "desc": "\u00a7 1910.7 \u2014 Definition and requirements for a nationally recognized testing laboratory. No further cross-references."
   },
   "sec_1910.331": {
    "desc": "\u00a7 1910.331 \u2014 Scope. Cross-references: \u00a7 1910.399, \u00a7 1910.332, \u00a7 1910.269, \u00a7 1910.333, \u00a7 1910.268."
   },
   "sec_1910.399": {
    "desc": "\u00a7 1910.399 \u2014 Definitions applicable to this subpart. Cross-references: \u00a7 1910.7."
   },
   "sec_1910.146": {
    "desc": "\u00a7 1910.146 \u2014 Permit-required confined spaces. Cross-references: \u00a7 1910.1200."
   },
   "sec_1910.141": {
    "desc": "\u00a7 1910.141 \u2014 Sanitation. Cross-references: \u00a7 1910.1000. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.1000."
   },
   "sec_1910.134": {
    "desc": "\u00a7 1910.134 \u2014 Respiratory protection. No further cross-references."
   },
   "sec_1910.1200": {
    "desc": "\u00a7 1910.1200 \u2014 Hazard communication. No further cross-references."
   },
   "ruling": {
    "desc": "\u00a7 1910.1000 \u2014 Air contaminants. No further cross-references. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.1000.  Determination stated here is PROVISIONAL pending the amendment check: confirm it against the current-status record in the amendments register before filing."
   },
   "amendment": {
    "desc": "Amendment note \u2014 the provisional determination above is confirmed as current; no superseding amendment is on file. The determination may now be filed."
   },
   "rejected": {
    "desc": "Filing REJECTED \u2014 filed before current-status confirmation, against a provision that does not govern, or without the competent-person certification. The case is closed."
   },
   "target": {
    "desc": "Filing ACCEPTED \u2014 \u00a7 1910.1000 is recorded as the governing provision for the rooftop work platform; the abatement determination was filed with the required competent-person certification. Task complete."
   }
