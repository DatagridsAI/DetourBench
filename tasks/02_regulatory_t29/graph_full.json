{
 "graph": {
  "nodes": {
   "start": {
    "desc": "Ticket: an inspection cited a rooftop work platform for inadequate fall protection and the employer disputes which standard applies. Establish which provision governs and file the abatement determination. Filing rule: ONE submission per case; a rejected filing closes it. Begin at \u00a7 1910.28 and follow the regulation's own cross-references."
   },
   "sec_1910.28": {
    "desc": "\u00a7 1910.28 \u2014 Duty to have fall protection and falling object protection. Cross-references: \u00a7 1910.29, \u00a7 1910.140, \u00a7 1910.66, \u00a7 1910.67, \u00a7 1910.268, \u00a7 1910.269. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.67."
   },
   "sec_1910.29": {
    "desc": "\u00a7 1910.29 \u2014 Fall protection systems and falling object protection\u2014criteria and practices. No further cross-references. This section states the competent-person certification that confers filing authority; the filing endpoint checks for it."
   },
   "sec_1910.140": {
    "desc": "\u00a7 1910.140 \u2014 Personal fall protection systems. No further cross-references. NOTE: the competent-person certification formerly stated here was removed by amendment and now appears elsewhere; this section confers no authority."
   },
   "sec_1910.66": {
    "desc": "\u00a7 1910.66 \u2014 Powered platforms for building maintenance. Cross-references: \u00a7 1910.140."
   },
   "sec_1910.67": {
    "desc": "\u00a7 1910.67 \u2014 Vehicle-mounted elevating and rotating work platforms. Cross-references: \u00a7 1910.6, \u00a7 1910.333. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.6."
   },
   "sec_1910.268": {
    "desc": "\u00a7 1910.268 \u2014 Telecommunications. Cross-references: \u00a7 1910.12, \u00a7 1910.5, \u00a7 1910.110."
   },
   "sec_1910.269": {
    "desc": "\u00a7 1910.269 \u2014 Electric power generation, transmission, and distribution. Cross-references: \u00a7 1910.12, \u00a7 1926.950, \u00a7 1910.332, \u00a7 1910.303, \u00a7 1910.333, \u00a7 1910.5."
   },
   "sec_1926.502": {
    "desc": "\u00a7 1926.502 \u2014 Fall protection systems criteria and practices. No further cross-references."
   },
   "sec_1910.30": {
    "desc": "\u00a7 1910.30 \u2014 Training requirements. Cross-references: \u00a7 1910.27."
   },
   "sec_1910.6": {
    "desc": "\u00a7 1910.6 \u2014 Incorporation by reference. Cross-references: \u00a7 1910.124, \u00a7 1910.120, \u00a7 1910.145, \u00a7 1910.111, \u00a7 1910.219, \u00a7 1910.262. For a rooftop work platform, the applicable provision is carried forward at \u00a7 1910.124."
   },
   "sec_1910.333": {
    "desc": "\u00a7 1910.333 \u2014 Selection and use of work practices. Cross-references: \u00a7 1910.147."
   },
   "sec_1910.12": {
    "desc": "\u00a7 1910.12 \u2014 Construction work. Cross-references: \u00a7 1926.13."
   },
   "sec_1910.5": {
    "desc": "\u00a7 1910.5 \u2014 Applicability of standards. Cross-references: \u00a7 1910.95, \u00a7 1910.261."
   },
   "sec_1910.110": {
    "desc": "\u00a7 1910.110 \u2014 Storage and handling of liquefied petroleum gases. Cross-references: \u00a7 1910.7, \u00a7 1910.6."
   },
   "sec_1926.950": {
    "desc": "\u00a7 1926.950 \u2014 General. Cross-references: \u00a7 1910.269, \u00a7 1910.5."
   },
   "sec_1910.332": {
    "desc": "\u00a7 1910.332 \u2014 Training. Cross-references: \u00a7 1910.303, \u00a7 1910.331, \u00a7 1910.333."
   },
   "sec_1910.303": {
    "desc": "\u00a7 1910.303 \u2014 General. Cross-references: \u00a7 1910.399."
   },
   "sec_1910.27": {
