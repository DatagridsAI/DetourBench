    "nodes": {
      "start": {
        "desc": "Internal case DTB-BANK-23. Elena Brooks reports a damaged older debit card and has a replacement card ending 5776. Close only the obsolete active card, activate the matching pending card using its authoritative recorded security values and activation PIN 0356, change its PIN to 8203, enable recurring-payment blocking, freeze it, and commit the completed lifecycle. Locate authoritative identifiers from the case records; do not alter pending lookalikes."
      },
      "case": {
        "desc": "Synthetic servicing packet DTB-BANK-23, opened 2026-04-04. Customer identity facts, account record, authoritative debit-card inventory, verification receipt and the versioned policy register are linked. [Provenance: customer/account/card facts derive from an internal synthetic TauBench fixture; workflow gates are authored overlay.]"
      },
      "user": {
        "desc": "Synthetic customer record. Name: Elena Brooks. Customer ID: syn65hard_0003_users_03. Email: elena.brooks+tau30003@example.test. Phone: 555-203-8486. Date of birth: 04/10/1983. Address: 103 Juniper Avenue, Portland, OR 97205."
      },
      "verification": {
        "desc": "Verification receipt DTB-BANK-23-V1: the authenticated caller matched the synthetic customer record; verification applies only to records owned by that customer in this case."
      },
      "account": {
        "desc": "Synthetic account record syn65hard_0003_accounts_01. Owner: syn65hard_0003_users_03. Class: checking. Status: OPEN. Opened: 04/02/2021. Product: Sky Blue Account."
      },
      "inventory": {
        "desc": "Authoritative debit-card inventory: four records. Page 1 contains the active older card and damaged reissue ending 5776. Page 2 contains two other pending cards. Inspect individual records before performing an irreversible action."
      },
      "inventory_page1": {
        "desc": "Page 1: ACTIVE syn65hard_0003_debit_cards_old ending 7003; PENDING syn65hard_0003_debit_cards_02 ending 5776."
      },
      "inventory_page2": {
        "desc": "Page 2: two PENDING lookalikes ending 8604 and 8605; neither matches the requested last four."
      },
      "old_card": {
        "desc": "Synthetic debit-card record syn65hard_0003_debit_cards_old. Account: syn65hard_0003_accounts_01. Owner: syn65hard_0003_users_03. Status: ACTIVE. Last four: 7003. Issued: 01/02/2024. Issue reason: new_account. Expiration: 12/29. CVV: 303."
      },
      "target_card": {
        "desc": "Synthetic debit-card record syn65hard_0003_debit_cards_02. Account: syn65hard_0003_accounts_01. Owner: syn65hard_0003_users_03. Status: PENDING. Last four: 5776. Issued: 04/02/2026. Issue reason: damaged. Expiration: 05/31. CVV: 066."
      },
      "distractor_card_1": {
        "desc": "Synthetic debit-card record syn65hard_0003_debit_cards_distractor_01. Account: syn65hard_0003_accounts_01. Owner: syn65hard_0003_users_03. Status: PENDING. Last four: 8604. Issued: 01/02/2025. Issue reason: new_account. Expiration: 11/30. CVV: 604."
      },
      "distractor_card_2": {
        "desc": "Synthetic debit-card record syn65hard_0003_debit_cards_distractor_02. Account: syn65hard_0003_accounts_01. Owner: syn65hard_0003_users_03. Status: PENDING. Last four: 8605. Issued: 01/02/2025. Issue reason: bank_reissue. Expiration: 12/30. CVV: 605."
      },
      "policy_register": {
        "desc": "Internal synthetic card-servicing policy register. CARD-2025A was superseded on 2026-01-01; CARD-2026B governs cases opened during 2026. CARD-2027C is prospective."
      },
      "policy_old": {
        "desc": "CARD-2025A — superseded. It does not distinguish new-card, replacement-card and reissued-card activation tools. Do not apply to a 2026 case."
      },
      "policy_current": {
        "desc": "CARD-2026B — in force. Verify ownership and OPEN account status. Select a card from the inventory by status, last four and issue reason; never act on a merely similar pending card. A damaged or bank-reissued card uses the reissue activation workflow. PIN work requires ACTIVE status. Recurring-payment blocking precedes a final freeze. Permanent closure is available only for an ACTIVE or PENDING card that is at least 14 days old, except for a documented security bypass; once accepted it is irreversible. Each successful write must be confirmed before the next dependent write."
      },
      "policy_future": {
        "desc": "CARD-2027C — prospective. Adds biometric verification and is not in force for this case."
      },
      "status_cache": {
        "desc": "Stale servicing cache for DTB-BANK-23, generated before the current case packet. It lists the newest issued card as ACTIVE without an authoritative card ID. The card inventory remains authoritative."
      },
      "generic_activation_faq": {
        "desc": "Public activation FAQ: most debit cards can be activated after delivery. It omits issue-reason-specific tool selection and is not an operational policy."
      },
      "credit_card_controls": {
        "desc": "Credit-card control guide. It concerns revolving credit cards, not debit cards linked to checking accounts."
      },
      "review": {
        "desc": "DTB-BANK-23 evidence review. Choose which card, if any, should be permanently closed. Only the obsolete ACTIVE card is requested; the newly issued target is not closure-eligible, while either older pending lookalike is eligible but outside the request. Closing an older pending lookalike is irreversible task failure."
      },
      "old_closed": {
        "desc": "Obsolete active card ending 7003 permanently closed for reason damaged."
      },
      "wrong_distractor_close_1": {
        "desc": "Terminal failure: the older pending lookalike ending 8604 was permanently closed."
      },
      "wrong_distractor_close_2": {
        "desc": "Terminal failure: the older pending lookalike ending 8605 was permanently closed."
      },
      "activated": {
        "desc": "False summit: the correct damaged reissue ending 5776 is ACTIVE, but PIN hardening, recurring-payment blocking and freeze remain."
      },
      "pin_changed": {
        "desc": "False summit: PIN changed from activation PIN 0356 to 8203; card controls remain incomplete."
      },
      "recurring_blocked": {
        "desc": "False summit: recurring-payment blocking enabled; final card freeze and audit commit remain."
      },
      "frozen": {
        "desc": "Correct target card frozen after all preceding controls were confirmed."
      },
      "target": {
