        "desc": "Synthetic debit-card record syn65hard_0018_debit_cards_02. Account: syn65hard_0018_accounts_01. Owner: syn65hard_0018_users_03. Status: ACTIVE. Last four: 4561. Issued: 07/02/2026. Issue reason: new_account. Expiration: 08/31. CVV: 851."
      },
      "inventory_pending": {
        "desc": "PENDING cards: lookalikes ending 8619 and 8620. PIN reset and freeze are forbidden while PENDING."
      },
      "distractor_card_1": {
        "desc": "Synthetic debit-card record syn65hard_0018_debit_cards_distractor_01. Account: syn65hard_0018_accounts_01. Owner: syn65hard_0018_users_03. Status: PENDING. Last four: 8619. Issued: 01/02/2025. Issue reason: new_account. Expiration: 11/30. CVV: 619."
      },
      "distractor_card_2": {
        "desc": "Synthetic debit-card record syn65hard_0018_debit_cards_distractor_02. Account: syn65hard_0018_accounts_01. Owner: syn65hard_0018_users_03. Status: PENDING. Last four: 8620. Issued: 01/02/2025. Issue reason: bank_reissue. Expiration: 12/30. CVV: 620."
      },
      "policy_register": {
        "desc": "Internal synthetic card-servicing policy register. CARD-2025A was superseded on 2026-01-01; CARD-2026B governs cases opened during 2026. CARD-2027C is prospective."
      },
      "policy_old": {
        "desc": "CARD-2025A — superseded. It does not distinguish new-card, replacement-card and reissued-card activation tools. Do not apply to a 2026 case."
      },
      "policy_current": {
        "desc": "CARD-2026B — in force. Verify ownership and OPEN account status. Select a card from the inventory by status, last four and issue reason; never act on a merely similar pending card. A damaged or bank-reissued card uses the reissue activation workflow. PIN work requires ACTIVE status. Recurring-payment blocking precedes a final freeze. Permanent closure is available only for an ACTIVE or PENDING card that is at least 14 days old, except for a documented security bypass; once accepted it is irreversible. Each successful write must be confirmed before the next dependent write."
      },
      "policy_future": {
        "desc": "CARD-2027C — prospective. Adds biometric verification and is not in force for this case."
      },
      "status_cache": {
        "desc": "Stale servicing cache for DTB-BANK-24, generated before the current case packet. It lists the newest issued card as ACTIVE without an authoritative card ID. The card inventory remains authoritative."
      },
      "generic_activation_faq": {
        "desc": "Public PIN help page: customers can request PIN assistance after identity verification. It omits card-status eligibility, backend action order and account-specific records, so it is not an operational policy."
      },
      "credit_card_controls": {
        "desc": "Credit-card control guide. It concerns revolving credit cards, not debit cards linked to checking accounts."
      },
      "review": {
        "desc": "DTB-BANK-24 evidence review. The request is a PIN reset followed by temporary controls, not permanent closure. Choose the correct entry action. The newly issued requested card is not closure-eligible; the two older pending lookalikes are eligible but outside the request, so closing either one is irreversible task failure."
      },
      "pin_reset": {
        "desc": "False summit: PIN reset to 7515 on the ACTIVE card ending 4561; recurring block and freeze remain."
      },
      "wrong_close_pending_1": {
        "desc": "Terminal failure: the older pending lookalike ending 8619 was permanently closed outside the request."
      },
      "wrong_close_pending_2": {
        "desc": "Terminal failure: the older pending lookalike ending 8620 was permanently closed outside the request."
      },
      "recurring_blocked": {
        "desc": "False summit: recurring-payment blocking enabled on the correct card; final freeze and audit remain."
      },
      "frozen": {
        "desc": "Correct ACTIVE card frozen after the PIN reset and recurring block were confirmed."
      },
      "target": {
